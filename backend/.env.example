# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000
SESSION_SECRET=replace-with-a-long-random-string

# Set to true to enable /auth/dev-login — logs you in as a fake test user
# so you can click through the full site before Discord/Google keys are set up.
# Set back to false (or remove) before this goes live.
DEV_MODE=true

# Admin panel password (single-operator login — pick something strong)
ADMIN_PASSWORD=replace-me

# Discord OAuth — from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
DISCORD_GUILD_ID=your-discord-server-id

# Google OAuth (for YouTube subscription check) — from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/youtube/callback
