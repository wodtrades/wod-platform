# Copy to .env and fill in. This bot reads/writes the SAME database file the
# web backend uses (backend/db/wod.sqlite) — no API calls between them needed.

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=              # same value as backend/.env
DISCORD_GUILD_ID=               # same value as backend/.env

# Role given automatically to anyone who's verified Discord membership.
# Create a "Verified" role in your server, then paste its ID here
# (right-click the role in Server Settings > Roles > Copy Role ID).
VERIFIED_ROLE_ID=

# Channel where winner announcements get posted. Leave blank to post
# wherever /draw was run instead.
ANNOUNCE_CHANNEL_ID=

# Comma-separated Discord user IDs allowed to run /draw and /pending.
# Right-click your own user in Discord (Developer Mode on) > Copy User ID.
ADMIN_DISCORD_IDS=
